# HV14 Water frontend configuration (no secrets belong here)
# Build-time app selection: water or energy for independent deployments.
# preview is only for reviewing both apps in Lovable.
VITE_HV14_APP=preview
# Production (Docker on the private server): same-origin /api, real data.
VITE_HV14_API_BASE_URL=
VITE_HV14_DATA_MODE=api
VITE_HV14_FRESHNESS_HOURS=8
# Development without the backend: set VITE_HV14_DATA_MODE=mock
